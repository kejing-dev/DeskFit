{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|exec_command|shell_command|(?:mcp__(?:pico-spatial-editor|pico_spatial_editor)__)?(?:start_editor_workflow|start_3d_generation_workflow))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/bytedance/Desktop/Spatial Apps/desk-fit/.claude/hooks/pico-spatial-agentic-tools/capture-context.mjs\" claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/bytedance/Desktop/Spatial Apps/desk-fit/.claude/hooks/pico-general-agentic-tools/ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Skill|Read|mcp__pico-(?:dev-knowledge|spatial-editor)__)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/bytedance/Desktop/Spatial Apps/desk-fit/.claude/hooks/pico-general-agentic-tools/ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__pico-(?:dev-knowledge|spatial-editor)__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/bytedance/Desktop/Spatial Apps/desk-fit/.claude/hooks/pico-general-agentic-tools/ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ]
  }
}
